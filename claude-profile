#!/bin/sh
# claude-profile: run several Claude Code logins side by side on one shared ~/.claude.
#
# Each profile is a small wrapper command (claude-<name>) that runs your normal `claude` with
# CLAUDE_SECURESTORAGE_CONFIG_DIR pointing at a per-profile folder. That variable moves only the
# stored login; settings, plugins, CLAUDE.md, MCP servers and history stay shared and live.
# The variable is internal to Claude Code (not documented), so `add` refuses a build that lacks it.
set -eu

PROFILES_HOME=${CLAUDE_PROFILES_HOME:-$HOME/.claude-profiles}
BIN_DIR=${CLAUDE_PROFILES_BIN:-$HOME/.local/bin}
MARKER="# generated by claude-profile"
TESTED_VERSIONS="2.1.330"
VAR=CLAUDE_SECURESTORAGE_CONFIG_DIR

die() { printf 'claude-profile: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

usage() {
	cat <<EOF
usage: claude-profile <command> [args]

  add <name>          create the claude-<name> command (then run it and /login)
  list                show profiles created by this tool
  doctor <name>       check the profile's login is stored apart from your main one
  remove [-y] <name>  delete claude-<name> and that profile's stored login

Profiles live in $PROFILES_HOME; commands go in $BIN_DIR.
Override with CLAUDE_PROFILES_HOME / CLAUDE_PROFILES_BIN.
EOF
}

valid_name() {
	case $1 in '' | -* | *[!a-z0-9-]* | profile) return 1 ;; esac
}

wrapper_for() { printf '%s/claude-%s' "$BIN_DIR" "$1"; }
store_for() { printf '%s/%s' "$PROFILES_HOME" "$1"; }
# A wrapper carries the marker as its second line; this script itself does not.
is_ours() { [ -f "$1" ] && sed -n 2p "$1" | grep -qF "$MARKER — profile "; }

# Claude Code reports a login for the profile while its own store is empty: the variable was ignored.
logged_in() { "$1" auth status 2>/dev/null | grep -q '"loggedIn": *true'; }

sha8() {
	if command -v shasum >/dev/null 2>&1; then
		printf %s "$1" | shasum -a 256
	else
		printf %s "$1" | sha256sum
	fi | cut -c1-8
}

# Claude Code's Keychain entry for a storage folder (macOS).
service_for() { printf 'Claude Code-credentials-%s' "$(sha8 "$1")"; }

is_macos() { [ "$(uname -s)" = Darwin ]; }

# Single-quote a string for a shell script.
quote() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }

require_name() {
	[ $# -ge 1 ] || die "missing profile name"
	valid_name "$1" || die "profile names use a-z, 0-9 and '-', and don't start with '-': $1"
}

claude_supports_var() {
	bin=$(command -v claude) || die "claude is not on PATH"
	LC_ALL=C grep -aqF "$VAR" "$bin"
}

cmd_add() {
	require_name "$@"
	name=$1
	wrapper=$(wrapper_for "$name")
	store=$(store_for "$name")

	if [ -e "$wrapper" ] && ! is_ours "$wrapper"; then
		die "$wrapper already exists and wasn't made by claude-profile; not touching it"
	fi
	if ! claude_supports_var; then
		die "this Claude Code build doesn't know $VAR, so a profile login would replace your main login. Not creating claude-$name."
	fi

	mkdir -p "$BIN_DIR" "$store"
	chmod 700 "$PROFILES_HOME" "$store"
	tmp="$wrapper.tmp.$$"
	cat >"$tmp" <<EOF
#!/bin/sh
$MARKER — profile $name
export CLAUDE_PROFILE=$(quote "$name")
export $VAR=$(quote "$store")
exec claude "\$@"
EOF
	chmod 755 "$tmp"
	mv "$tmp" "$wrapper"

	if [ -z "$(access_token "$store")" ] && logged_in "$wrapper"; then
		rm -f "$wrapper"
		die "claude-$name reports a login although its own store is empty, so Claude Code is ignoring $VAR (or CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_API_KEY is set in your shell). Removed claude-$name."
	fi

	say "Created $wrapper"
	case ":$PATH:" in *":$BIN_DIR:"*) ;; *) say "Note: $BIN_DIR is not on your PATH." ;; esac
	say "Next: run claude-$name, type /login and sign in with the other account."
	say "Then: claude-profile doctor $name"
}

cmd_list() {
	found=0
	for f in "$BIN_DIR"/claude-*; do
		is_ours "$f" || continue
		found=1
		say "$(basename "$f")	$(sed -n "s/^export $VAR=//p" "$f")"
	done
	[ "$found" = 1 ] || say "no profiles"
}

# Prints the access token for a store folder, or nothing. Empty folder = the main login.
access_token() {
	json=""
	if is_macos; then
		if [ -n "$1" ]; then service=$(service_for "$1"); else service="Claude Code-credentials"; fi
		json=$(security find-generic-password -s "$service" -w 2>/dev/null || true)
	fi
	if [ -z "$json" ]; then
		file="${1:-$HOME/.claude}/.credentials.json"
		[ -f "$file" ] && json=$(cat "$file")
	fi
	# The entry can hold other tokens (MCP servers); take the one inside claudeAiOauth.
	printf %s "$json" | sed -n 's/.*"claudeAiOauth" *: *{[^}]*"accessToken" *: *"\([^"]*\)".*/\1/p'
}

# Prints the email the token belongs to. The token goes to curl on stdin, never in argv.
email_for_token() {
	[ -n "$1" ] || return 0
	printf 'Authorization: Bearer %s\nanthropic-beta: oauth-2025-04-20\n' "$1" |
		curl -fsS --max-time 10 -H @- https://api.anthropic.com/api/oauth/profile 2>/dev/null |
		sed -n 's/.*"account" *: *{[^}]*"email" *: *"\([^"]*\)".*/\1/p'
}

cmd_doctor() {
	require_name "$@"
	name=$1
	wrapper=$(wrapper_for "$name")
	store=$(store_for "$name")
	ok=1

	is_ours "$wrapper" || die "no profile '$name' (expected $wrapper)"

	version=$(claude --version 2>/dev/null | cut -d' ' -f1)
	case " $TESTED_VERSIONS " in
	*" $version "*) say "ok    Claude Code $version (tested)" ;;
	*) say "warn  Claude Code $version has not been tested with claude-profile (tested: $TESTED_VERSIONS)" ;;
	esac

	if claude_supports_var; then
		say "ok    this Claude Code build knows $VAR"
	else
		say "FAIL  this Claude Code build doesn't know $VAR: claude-$name would use your main login"
		ok=0
	fi

	profile_token=$(access_token "$store")
	if [ -z "$profile_token" ] && logged_in "$wrapper"; then
		say "FAIL  claude-$name reports a login but its own store is empty: it is using another login"
		exit 1
	fi
	if [ -z "$profile_token" ]; then
		if is_macos; then where="Keychain entry \"$(service_for "$store")\""; else where="$store/.credentials.json"; fi
		say "warn  no login stored for '$name' yet ($where). Run claude-$name and /login."
		[ "$ok" = 1 ] && exit 0 || exit 1
	fi
	say "ok    login stored apart from the main one"

	profile_email=$(email_for_token "$profile_token")
	main_email=$(email_for_token "$(access_token "")")
	if [ -z "$profile_email" ]; then
		say "warn  couldn't look up the account (offline, or the login expired; running claude-$name refreshes it)"
	elif [ "$profile_email" = "$main_email" ]; then
		say "FAIL  claude-$name and claude are both logged in as $profile_email"
		ok=0
	elif [ -z "$main_email" ]; then
		say "warn  claude-$name is $profile_email; couldn't look up the account claude uses"
	else
		say "ok    claude-$name is $profile_email; claude is $main_email"
	fi

	[ "$ok" = 1 ]
}

cmd_remove() {
	yes=0
	if [ "${1:-}" = -y ]; then yes=1; shift; fi
	require_name "$@"
	name=$1
	wrapper=$(wrapper_for "$name")
	store=$(store_for "$name")

	is_ours "$wrapper" || die "no profile '$name' (expected $wrapper)"

	if [ "$yes" != 1 ]; then
		printf 'Delete claude-%s and the login stored for it? [y/N] ' "$name"
		read -r answer || answer=""
		case $answer in y | Y | yes) ;; *) say "Nothing removed."; exit 0 ;; esac
	fi

	rm -f "$wrapper"
	# Only this profile's own store is touched; the main login is never deleted here.
	if is_macos; then
		security delete-generic-password -s "$(service_for "$store")" >/dev/null 2>&1 || true
	fi
	rm -f "$store/.credentials.json"
	rmdir "$store" 2>/dev/null || true
	say "Removed claude-$name."
}

[ $# -ge 1 ] || { usage; exit 1; }
command=$1
shift
case $command in
add) cmd_add "$@" ;;
list) cmd_list ;;
doctor) cmd_doctor "$@" ;;
remove) cmd_remove "$@" ;;
-h | --help | help) usage ;;
*) usage >&2; exit 1 ;;
esac
